// Scoreboard persistence and ranking helpers.

List<Score> loadScores() {
    var f = Path("data/scores.json")
    if (!f.exists()) {
        return listOf()
    }
    var text = f.readText()
    if (text == null || text == "") {
        return listOf()
    }
    var list = json.decode<List<Score>>(text)
    if (list == null) {
        return listOf()
    }
    return list
}

Bool saveScores(List<Score> list) {
    var dir = Path("data")
    dir.createDirectories()
    var f = Path("data/scores.json")
    return f.writeText(json.encode(list))
}

void sortDesc(List<Score> list) {
    var n = list.size()
    var i = 1
    while (i < n) {
        var j = i
        while (j > 0) {
            var cur = list.get(j)
            var prev = list.get(j - 1)
            if (cur.score > prev.score) {
                list.set(j, prev)
                list.set(j - 1, cur)
            }
            j = j - 1
        }
        i = i + 1
    }
}

List<Score> head(List<Score> list, Int limit) {
    var out = listOf<Score>()
    var n = list.size()
    if (n > limit) {
        n = limit
    }
    var i = 0
    while (i < n) {
        out.add(list.get(i))
        i = i + 1
    }
    return out
}

String scoresPayload(Int limit) {
    var list = loadScores()
    sortDesc(list)
    return json.encode(head(list, limit))
}
