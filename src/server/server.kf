// Byte Eater — fullstack backend (kof.web, JVM target).
// Serves the compiled kofjs frontend (web/) and a durable scoreboard API.
// Persistence is a JSON file under data/scores.json via kof.io.
//
// Functions are deliberately small: the kof JVM backend crashes on deep
// stack frames (ASM COMPUTE_FRAMES), so handlers only delegate.
//
// Run from the project root:
//   make web                # build the frontend into web/
//   kof serve src/server/server.kf --port 8080
//
// API:
//   GET  /api/health                service + game info
//   GET  /api/scores?limit=N        top-N scoreboard (default 10)
//   POST /api/scores                submit {name, score, level}
//                                   -> 201 + top-10, 400 on bad payload

record Score(String name, Int score, Int level)
record Submit(String name, Int score, Int level)
record Result(Int code, String payload)

// ---------------------------------------------------------------- storage

List<Score> loadScores() {
    var f = Path("data/scores.json")
    if (!f.exists()) {
        return listOf()
    }
    var text = f.readText()
    if (text == null || text == "") {
        return listOf()
    }
    var list = json.decode<List<Score>>(text)
    if (list == null) {
        return listOf()
    }
    return list
}

Bool saveScores(List<Score> list) {
    var dir = Path("data")
    dir.createDirectories()
    var f = Path("data/scores.json")
    return f.writeText(json.encode(list))
}

// ---------------------------------------------------------------- helpers

Int limitFrom(String? raw) {
    if (raw == null) {
        return 10
    }
    var parsed = raw.toInt()
    if (parsed > 0 && parsed <= 100) {
        return parsed
    }
    return 10
}

void sortDesc(List<Score> list) {
    var n = list.size()
    var i = 1
    while (i < n) {
        var j = i
        while (j > 0) {
            var cur = list.get(j)
            var prev = list.get(j - 1)
            if (cur.score > prev.score) {
                list.set(j, prev)
                list.set(j - 1, cur)
            }
            j = j - 1
        }
        i = i + 1
    }
}

List<Score> head(List<Score> list, Int limit) {
    var out = listOf<Score>()
    var n = list.size()
    if (n > limit) {
        n = limit
    }
    var i = 0
    while (i < n) {
        out.add(list.get(i))
        i = i + 1
    }
    return out
}

String scoresPayload(Int limit) {
    var list = loadScores()
    sortDesc(list)
    return json.encode(head(list, limit))
}

// ---------------------------------------------------------------- submit

Bool nameOk(String name) {
    if (name.length() < 1 || name.length() > 12) {
        return false
    }
    var i = 0
    while (i < name.length()) {
        var ch = name.charAt(i)
        var okChar = ch >= 'a' && ch <= 'z'
        if (!okChar) {
            okChar = ch >= 'A' && ch <= 'Z'
        }
        if (!okChar) {
            okChar = ch >= '0' && ch <= '9'
        }
        if (!okChar) {
            okChar = ch == ' '
        }
        if (!okChar) {
            return false
        }
        i = i + 1
    }
    return true
}

Result validate(Submit s) {
    if (!nameOk(s.name)) {
        return Result(400, "{\"error\": \"name must be 1-12 chars [a-zA-Z0-9 ]\"}")
    }
    if (s.score < 0 || s.score > 9999999) {
        return Result(400, "{\"error\": \"score out of range\"}")
    }
    if (s.level < 1 || s.level > 999) {
        return Result(400, "{\"error\": \"level out of range\"}")
    }
    return Result(0, "")
}

Result doSubmit(String body) {
    if (body == null || body.length() == 0) {
        return Result(400, "{\"error\": \"empty body\"}")
    }
    var parsed = json.decode<Submit>(body)
    if (parsed == null) {
        return Result(400, "{\"error\": \"invalid json\"}")
    }
    var bad = validate(parsed)
    if (bad.code != 0) {
        return bad
    }
    var list = loadScores()
    list.add(Score(parsed.name, parsed.score, parsed.level))
    sortDesc(list)
    var trimmed = head(list, 50)
    saveScores(trimmed)
    return Result(201, json.encode(head(trimmed, 10)))
}

// ---------------------------------------------------------------- app

main() {
    var app = web.app()

    app.get("/api/health") {
        return "{\"ok\": true, \"game\": \"byte-eater\", \"lang\": \"kof\", \"langVersion\": \"0.3.2-beta\"}"
    }

    app.get("/api/scores") {
        return scoresPayload(limitFrom(query("limit")))
    }

    app.post("/api/scores") {
        var r = doSubmit(body())
        if (r.code == 400) {
            return status(400, r.payload)
        }
        return status(201, r.payload)
    }

    app.serveDir("/", "web")

    var wd = Path("web")
    var webAbs = wd.toAbsolute().path()
    app.serveDir("/", webAbs)

    app.listen(8080)
    println("byte eater server on :8080")
}
