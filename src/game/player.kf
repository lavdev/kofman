// Player movement, pellet collection and player animation.

Int playerSpeed() {
    return playerSpeedForLevel(G.level)
}

void movePlayer() {
    // resting on a tile center: try to turn, then commit the next tile
    var turnX = G.ptx
    var turnY = G.pty
    if (G.want == 0) { turnX = G.ptx - 1 }
    if (G.want == 1) { turnX = G.ptx + 1 }
    if (G.want == 2) { turnY = G.pty - 1 }
    if (G.want == 3) { turnY = G.pty + 1 }
    if (isFloorAt(turnX, turnY)) {
        G.dir = G.want
    }
    var aheadX = G.ptx
    var aheadY = G.pty
    if (G.dir == 0) { aheadX = G.ptx - 1 }
    if (G.dir == 1) { aheadX = G.ptx + 1 }
    if (G.dir == 2) { aheadY = G.pty - 1 }
    if (G.dir == 3) { aheadY = G.pty + 1 }
    if (!isFloorAt(aheadX, aheadY)) {
        G.moving = false
        return
    }
    G.ptx = aheadX
    G.pty = aheadY
    G.moving = true
}

void stepPlayer() {
    var still = !G.moving
    if (still) {
        return
    }
    var targetX = G.ptx * G.T + 32
    var targetY = G.pty * G.T + 32
    var atX = G.px == targetX
    var atY = G.py == targetY
    if (atX && atY) {
        arrivePlayer()
        return
    }
    var step = G.speed
    var horiz = G.dir == 0
    var isRight = G.dir == 1
    var isDown = G.dir == 3
    if (horiz) {
        G.px = G.px - step
        if (G.px < targetX) {
            G.px = targetX
        }
        if (G.px == targetX) {
            arrivePlayer()
        }
    } else {
        if (isRight) {
            G.px = G.px + step
            if (G.px > targetX) {
                G.px = targetX
            }
            if (G.px == targetX) {
                arrivePlayer()
            }
        } else {
            if (isDown) {
                G.py = G.py + step
                if (G.py > targetY) {
                    G.py = targetY
                }
            } else {
                G.py = G.py - step
                if (G.py < targetY) {
                    G.py = targetY
                }
            }
            if (G.py == targetY) {
                arrivePlayer()
            }
        }
    }
}

void arrivePlayer() {
    var ch = glyph(G.ptx, G.pty)
    if (ch == '.' || ch == 'o') {
        var wasPower = ch == 'o'
        clearCell(G.ptx, G.pty)
        if (wasPower) {
            G.score = G.score + 50
            G.fright = 70 - (G.level - 1) * 8
            if (G.fright < 25) { G.fright = 25 }
            frightOn()
            G.msg = "byte azul! os bugs estao assustados"
        } else {
            G.score = G.score + 10
        }
        G.pelletsLeft = G.pelletsLeft - 1
        if (G.pelletsLeft <= 0) {
            G.mode = 4
            G.modeT = 9
            G.moving = false
            G.msg = "nivel completo!"
            return
        }
    }
    movePlayer()
}

Int playerFrame() {
    var idle = G.mode == 0 || G.mode == 3
    if (idle || G.mode == 2) {
        return 12 + (G.tick / 3) % 4
    }
    return (G.tick / 2) % 4
}

Bool playerFlip() {
    return G.dir == 0
}
