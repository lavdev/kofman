// Player movement, pellet collection and player animation.

Int playerSpeed() {
    return playerSpeedForLevel(G.level)
}

void movePlayer() {
    // resting on a tile center: try to turn, then commit the next tile
    var turnX = G.ptx
    var turnY = G.pty
    turnX = nextX(G.ptx, G.want)
    turnY = nextY(G.pty, G.want)
    if (isFloorAt(turnX, turnY)) {
        G.dir = G.want
    }
    var aheadX = G.ptx
    var aheadY = G.pty
    aheadX = nextX(G.ptx, G.dir)
    aheadY = nextY(G.pty, G.dir)
    if (!isFloorAt(aheadX, aheadY)) {
        G.moving = false
        return
    }
    G.ptx = aheadX
    G.pty = aheadY
    G.moving = true
}

void stepPlayer() {
    var still = !G.moving
    if (still) {
        return
    }
    var targetX = G.ptx * G.T + 32
    var targetY = G.pty * G.T + 32
    var atX = G.px == targetX
    var atY = G.py == targetY
    if (atX && atY) {
        arrivePlayer()
        return
    }
    var step = G.speed
    var horiz = G.dir == 0
    var isRight = G.dir == 1
    var isDown = G.dir == 3
    if (horiz) {
        G.px = G.px - step
        if (G.px < targetX) {
            G.px = targetX
        }
        if (G.px == targetX) {
            arrivePlayer()
        }
    } else {
        if (isRight) {
            G.px = G.px + step
            if (G.px > targetX) {
                G.px = targetX
            }
            if (G.px == targetX) {
                arrivePlayer()
            }
        } else {
            if (isDown) {
                G.py = G.py + step
                if (G.py > targetY) {
                    G.py = targetY
                }
            } else {
                G.py = G.py - step
                if (G.py < targetY) {
                    G.py = targetY
                }
            }
            if (G.py == targetY) {
                arrivePlayer()
            }
        }
    }
}

void arrivePlayer() {
    var ch = glyph(G.ptx, G.pty)
    if (isPellet(ch)) {
        var wasPower = isPowerPellet(ch)
        clearCell(G.ptx, G.pty)
        if (wasPower) {
            G.score = G.score + pelletScore(ch)
            G.fright = frightDuration(G.level)
            frightOn()
            G.msg = "byte azul! os bugs estao assustados"
        } else {
            G.score = G.score + pelletScore(ch)
        }
        G.pelletsLeft = G.pelletsLeft - 1
        if (G.pelletsLeft <= 0) {
            G.mode = 4
            G.modeT = 9
            G.moving = false
            G.msg = "nivel completo!"
            return
        }
    }
    movePlayer()
}

Int playerFrame() {
    var idle = G.mode == 0 || G.mode == 3
    if (idle || G.mode == 2) {
        return idlePlayerFrame(G.tick)
    }
    return activePlayerFrame(G.tick)
}

Bool playerFlip() {
    return G.dir == 0
}
