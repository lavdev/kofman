// Bug movement, targeting, frightened state and animation.

Int bugSpeed(Bug b) {
    if (b.st == 2) {
        return 48
    }
    if (b.st == 1) {
        return 13
    }
    var s = 20 + (G.level - 1) * 3 + b.id * 2
    if (s > 40) {
        s = 40
    }
    return s
}

Int opposite(Int d) {
    if (d == 0) { return 1 }
    if (d == 1) { return 0 }
    if (d == 2) { return 3 }
    return 2
}

Int dist2(Int x1, Int y1, Int x2, Int y2) {
    var dx = x1 - x2
    var dy = y1 - y2
    return dx * dx + dy * dy
}

Int pickDir(Bug b, Int targX, Int targY, Int rnd) {
    var opts = listOf<Int>()
    var d = 0
    while (d < 4) {
        var nx = b.tx
        var ny = b.ty
        if (d == 0) { nx = nx - 1 }
        if (d == 1) { nx = nx + 1 }
        if (d == 2) { ny = ny - 1 }
        if (d == 3) { ny = ny + 1 }
        if (isFloorAt(nx, ny) && d != opposite(b.last)) {
            opts.add(d)
        }
        d = d + 1
    }
    if (opts.size() == 0) {
        return opposite(b.last)
    }
    if (b.st == 1) {
        return opts.get(rnd % opts.size())
    }
    var best = opts.get(0)
    var bestD = 99999999
    for (var o in opts) {
        var nx = b.tx
        var ny = b.ty
        if (o == 0) { nx = nx - 1 }
        if (o == 1) { nx = nx + 1 }
        if (o == 2) { ny = ny - 1 }
        if (o == 3) { ny = ny + 1 }
        var dd = dist2(nx, ny, targX, targY)
        if (dd < bestD) {
            bestD = dd
            best = o
        }
    }
    return best
}

void chooseBugTarget(Bug b) {
    var tx = G.ptx
    var ty = G.pty
    if (b.st == 0) {
        var pulse = (G.tick / 90) % 2
        if (pulse == 0) {
            tx = G.ptx
            ty = G.pty
        } else {
            tx = b.scatterX
            ty = b.scatterY
        }
    }
    if (b.st == 2) {
        tx = b.homeX
        ty = b.homeY
    }
    var rnd = G.tick + b.id * 17 + b.tx * 3 + b.ty * 5
    var nd = pickDir(b, tx, ty, rnd)
    b.dir = nd
    b.last = nd
}

void commitBug(Bug b) {
    var nx = b.tx
    var ny = b.ty
    if (b.dir == 0) { nx = b.tx - 1 }
    if (b.dir == 1) { nx = b.tx + 1 }
    if (b.dir == 2) { ny = b.ty - 1 }
    if (b.dir == 3) { ny = b.ty + 1 }
    if (isFloorAt(nx, ny)) {
        b.tx = nx
        b.ty = ny
    }
}

void stepBug(Bug b) {
    var speed = bugSpeed(b)
    var targetX = b.tx * G.T + 32
    var targetY = b.ty * G.T + 32
    var atX = b.px == targetX
    var atY = b.py == targetY
    if (atX && atY) {
        bugArrive(b)
        return
    }
    var goLeft = b.dir == 0
    var isRight = b.dir == 1
    var isDown = b.dir == 3
    if (goLeft) {
        b.px = b.px - speed
        if (b.px < targetX) {
            b.px = targetX
        }
        if (b.px == targetX) {
            bugArrive(b)
        }
    } else {
        if (isRight) {
            b.px = b.px + speed
            if (b.px > targetX) {
                b.px = targetX
            }
            if (b.px == targetX) {
                bugArrive(b)
            }
        } else {
            if (isDown) {
                b.py = b.py + speed
                if (b.py > targetY) {
                    b.py = targetY
                }
            } else {
                b.py = b.py - speed
                if (b.py < targetY) {
                    b.py = targetY
                }
            }
            if (b.py == targetY) {
                bugArrive(b)
            }
        }
    }
}

void bugArrive(Bug b) {
    if (b.st == 2 && b.tx == b.homeX && b.ty == b.homeY) {
        b.st = 0
        b.last = 0
    }
    chooseBugTarget(b)
    commitBug(b)
}

void frightOn() {
    var bs = G.bugs
    for (var b in bs) {
        if (b.st == 0) {
            b.st = 1
        }
    }
}

void frightOff() {
    var bs = G.bugs
    for (var b in bs) {
        if (b.st == 1) {
            b.st = 0
        }
    }
}

Int bugFrame(Bug b) {
    if (b.kind == 0) {
        return 16 + (G.tick / 2) % 4
    }
    if (b.kind == 1) {
        return 20 + (G.tick / 2) % 2
    }
    return 22 + (G.tick / 2) % 2
}
