// Sprite catalog and asset loading.

Int img(Int base) {
    var ims = G.imgs
    return ims.get(base)
}

void addImg(String src) {
    var im = Image(src)
    var ims = G.imgs
    ims.add(im)
}

void loadSprites() {
    addImg("sprites/player_run_0.png")
    addImg("sprites/player_run_1.png")
    addImg("sprites/player_run_2.png")
    addImg("sprites/player_run_3.png")
    addImg("sprites/player_alt_0.png")
    addImg("sprites/player_alt_1.png")
    addImg("sprites/player_alt_2.png")
    addImg("sprites/player_alt_3.png")
    addImg("sprites/player_byte_0.png")
    addImg("sprites/player_byte_1.png")
    addImg("sprites/player_byte_2.png")
    addImg("sprites/player_byte_3.png")
    addImg("sprites/player_zzz_0.png")
    addImg("sprites/player_zzz_1.png")
    addImg("sprites/player_zzz_2.png")
    addImg("sprites/player_zzz_3.png")
    addImg("sprites/bug_blue_0.png")
    addImg("sprites/bug_blue_1.png")
    addImg("sprites/bug_blue_2.png")
    addImg("sprites/bug_blue_3.png")
    addImg("sprites/bug_pink_0.png")
    addImg("sprites/bug_pink_1.png")
    addImg("sprites/bug_orange_0.png")
    addImg("sprites/bug_orange_1.png")
}
