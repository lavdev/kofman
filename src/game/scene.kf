// Pure scene construction. Canvas/Label handles stay in main.kf.

void buildScene(List<Int> ops) {
    opRect(ops, 0, 0, G.CW, G.CH, 0)

    // walls batched
    opBegin(ops)
    var y = 0
    while (y < G.ROWS) {
        var x = 0
        while (x < G.COLS) {
            if (glyph(x, y) == '#') {
                var x0 = x * G.T
                var y0 = y * G.T
                opMt(ops, x0, y0)
                opLt(ops, x0 + G.T, y0)
                opLt(ops, x0 + G.T, y0 + G.T)
                opLt(ops, x0, y0 + G.T)
            }
            x = x + 1
        }
        y = y + 1
    }
    opFill(ops, 1)
    opBegin(ops)
    y = 0
    while (y < G.ROWS) {
        var x = 0
        while (x < G.COLS) {
            if (glyph(x, y) == '#') {
                var x0 = x * G.T
                var y0 = y * G.T
                opMt(ops, x0 + 6, y0 + 6)
                opLt(ops, x0 + 6, y0 + 18)
                opLt(ops, x0 + 18, y0 + 6)
            }
            x = x + 1
        }
        y = y + 1
    }
    opFill(ops, 2)

    // geek pellets: small amber chips with a binary-looking core
    y = 0
    while (y < G.ROWS) {
        var x = 0
        while (x < G.COLS) {
            if (glyph(x, y) == '.') {
                var px = x * G.T
                var py = y * G.T
                opRect(ops, px + 27, py + 27, px + 37, py + 37, 3)
                opRect(ops, px + 30, py + 30, px + 32, py + 34, 6)
                opRect(ops, px + 34, py + 30, px + 35, py + 34, 6)
            }
            x = x + 1
        }
        y = y + 1
    }

    // power bytes: larger cyan data packets with a 01 core
    y = 0
    while (y < G.ROWS) {
        var x = 0
        while (x < G.COLS) {
            if (glyph(x, y) == 'o') {
                var bx = x * G.T
                var by = y * G.T
                opRect(ops, bx + 21, by + 21, bx + 43, by + 43, 4)
                opRect(ops, bx + 26, by + 26, bx + 29, by + 38, 5)
                opRect(ops, bx + 34, by + 26, bx + 37, by + 38, 5)
            }
            x = x + 1
        }
        y = y + 1
    }

    // pause overlay
    if (G.mode == 5) {
        opAlpha(ops, 45)
        opRect(ops, 0, 0, G.CW, G.CH, 6)
        opAlpha(ops, 100)
    }

    drawEntities(ops)
}

void drawEntities(List<Int> ops) {
    var bs = G.bugs
    for (var b in bs) {
        var blink = false
        if (b.st == 1 && G.fright > 0 && G.fright < 20) {
            blink = G.tick % 2 == 0
        }
        if (!blink) {
            var f = bugFrame(b)
            var flip = 0
            if (!b.rightArt && b.dir == 1) {
                flip = 1
            }
            var alpha = 100
            if (b.st == 1) {
                alpha = 55
            }
            opSpr(ops, img(f), b.px - 32, b.py - 32, flip, alpha)
        }
    }
    opSpr(ops, img(playerFrame()), G.px - 32, G.py - 32, playerFlip(), 100)
}
