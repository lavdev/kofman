// Pure pellet rules. Rendering can evolve without changing these values.

Bool isPellet(Char glyph) {
    return glyph == '.' || glyph == 'o'
}

Bool isPowerPellet(Char glyph) {
    return glyph == 'o'
}

Int pelletScore(Char glyph) {
    if (glyph == 'o') {
        return 50
    }
    if (glyph == '.') {
        return 10
    }
    return 0
}

test "normal and power pellets are consumable" {
    assert(isPellet('.'), "normal pellet")
    assert(isPellet('o'), "power pellet")
    assert(!isPellet(' '), "empty floor")
    assert(!isPellet('#'), "wall")
}

test "power pellets are distinct" {
    assert(!isPowerPellet('.'), "normal pellet is not power")
    assert(isPowerPellet('o'), "power pellet")
}

test "pellet scores follow arcade rules" {
    assert(pelletScore('.') == 10, "normal score")
    assert(pelletScore('o') == 50, "power score")
    assert(pelletScore(' ') == 0, "empty score")
}
