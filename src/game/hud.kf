// Pure HUD text formatting.

String pad(Int v, Int w) {
    var s = "" + v
    while (s.length() < w) {
        s = "0" + s
    }
    return s
}

String hudText() {
    var text = "1UP " + pad(G.score, 6)
    text = text + "   LVL " + G.level
    text = text + "   LIVES " + G.lives
    text = text + "   HIGH " + pad(G.hi, 6)
    return text
}
